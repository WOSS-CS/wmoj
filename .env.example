# wmoj-app environment variables
#
# Copy to `main/.env.local` for local development. The Next.js app is `main/`, not the repo root,
# so that is where the real file lives. In production these are set in the Vercel dashboard.
#
# NEXT_PUBLIC_* are inlined into the browser bundle at build time and are PUBLIC. Everything without
# that prefix is server-only and must never gain a NEXT_PUBLIC_ prefix.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Project URL. Public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key. Public by design — it ships in the browser bundle and RLS is the boundary.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Secret key (formerly the service_role key). SERVER-ONLY. Bypasses RLS entirely.
#
# Used by the `add-problem` skill scripts, and by the submit route to read a problem's test data on
# behalf of a student who must not be able to read it themselves — the one case RLS cannot express,
# because the route runs on the student's own token. Never import the client that holds this from a
# client component, and never let its result become a client-component prop.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Judge service (wmoj-judge)
# ---------------------------------------------------------------------------

# Public prefix of the judge, but read SERVER-SIDE ONLY — the browser must never learn the judge URL,
# which is why /status proxies through api/status/health. Keeps the NEXT_PUBLIC_ prefix for historical
# reasons; do not start reading it from client code.
NEXT_PUBLIC_JUDGE_URL=https://your-judge.onrender.com

# Shared secret sent to the judge as the `X-Judge-Token` header. SERVER-ONLY.
# Must be byte-identical to JUDGE_SHARED_SECRET in wmoj-judge, or every submission fails auth.
JUDGE_SHARED_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Absolute origin of this app. Used for sitemap/robots/metadata and absolute links. Public.
NEXT_PUBLIC_BASE_URL=https://wmoj.ca

# Set automatically by Next.js and by Vercel. Only set this by hand for a local production build.
# NODE_ENV=development
